# Numeric ad account id without `act_` prefix (example: 123456789012345)
AD_ACCOUNT_ID=

# Exact campaign name to open
CAMPAIGN_NAME=

# Ad set index number used for name template: MMDD 리타겟 {번호}번 광고세트
ADSET_INDEX=1

# Chrome user data root directory (Windows example)
# C:\Users\<YOUR_USER>\AppData\Local\Google\Chrome\User Data
CHROME_USER_DATA_DIR=

# Chrome profile directory name inside User Data (examples: Default, Profile 1)
CHROME_PROFILE_DIR=Default

# Optional: folder path to upload all media files automatically
# example: C:\\ads\\creative-set-1
MEDIA_FOLDER_PATH=
